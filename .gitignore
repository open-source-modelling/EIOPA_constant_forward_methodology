# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test, coverage and type-checker caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pyright/

# --- Editors -----------------------------------------------------------------
# Keep the shared VS Code settings (import path and test configuration), ignore the rest
.vscode/*
!.vscode/settings.json
.idea/

# --- Operating system ----------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# --- Excel ---------------------------------------------------------------------
# Lock files Excel creates next to an open workbook
~$*

# --- Generated by the archived scripts ------------------------------------------
# The archived single-file versions write their results next to themselves
Archive/Output/

